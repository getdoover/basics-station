services:
  basic-station:
    image: xoseperez/basicstation:latest
    environment:
      - MODEL={{concentrator_model}}
      - INTERFACE={{interface}}
      - TTS_REGION={{ttn_region}}
      - TC_KEY={{ttn_api_key}}
      - GW_ID={{gateway_eui}}
      - DEVICE={{device_path}}
    volumes:
      - /dev:/dev

    privileged: true
    network_mode: host
    restart: unless-stopped
